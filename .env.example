# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# Required: exactly 24 characters. Used by:
#   GET /api/clear-blog-cache/[slug]      — clear one blog post
#   GET /api/clear-blog-list-cache        — clear blog list + homepage snippet
#   GET /api/clear-cache                  — clear prediction JSON caches in public/cache
BLOG_CACHE_CLEAR_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Optional alias for /api/clear-cache (falls back to BLOG_CACHE_CLEAR_KEY if unset)
CACHE_CLEAR_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
